# ============================================
# VOKO ACCESORIOS — Plantilla de variables de entorno
# Copiá este archivo como `.env` y completá los valores.
# El `.env` real está en .gitignore y nunca se sube al repo.
#
# En Vercel, estas mismas variables se cargan en:
#   Project Settings → Environment Variables
# ============================================

# ── Panel de administración (/admin) ──
# SHA-256 de la contraseña de acceso. La contraseña en texto plano
# no se guarda en ningún archivo del proyecto.
#
# Generar el hash de una contraseña nueva (PowerShell):
#   $h = [System.Security.Cryptography.SHA256]::Create().ComputeHash([Text.Encoding]::UTF8.GetBytes('tu-clave-nueva'))
#   ($h | ForEach-Object { $_.ToString('x2') }) -join ''
#
# Si esta variable falta, el login rechaza cualquier contraseña
# y avisa que el acceso no está configurado.
VITE_ADMIN_PASSWORD_HASH=

# ── Supabase ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
